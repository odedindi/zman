{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/nemotron-3-ultra-free",
     "permission": {
     "read": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.ssh/**": "deny",
    },
    "edit": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.ssh/**": "deny",
    },
    "write": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.ssh/**": "deny",
    }
  }
}
